# ==============================================================================
# BoxPhoneControl - Cấu hình mẫu môi trường (.env)
# Sao chép file này thành .env trong thư mục gốc hoặc %LOCALAPPDATA%\BoxPhoneControl\.env
# ==============================================================================

# 1. Cấu hình ADB & Phần cứng
# Đường dẫn adb.exe (mặc định nếu dùng tool Xiaowei: C:\Program Files (x86)\xiaowei_android\tools\adb.exe)
ADB_PATH=C:\Program Files (x86)\xiaowei_android\tools\adb.exe
# Cổng ADB đa tiến trình (hỗ trợ Box 40 máy song song)
ADB_PORTS=5037,5038

# 2. Cấu hình Telegram Bot (Điều khiển & Báo cáo)
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFICATIONS_ENABLED=1
# Danh sách Telegram user ID được phép điều khiển bot (phân cách bằng dấu phẩy, để trống = tất cả)
ALLOWED_USER_IDS=

# 3. Cấu hình Notion (Đồng bộ từ khóa & Comment)
NOTION_API_TOKEN=
NOTION_DATA_SOURCE_ID=654a56cd7cf5416fb65f9b934a62ec45
NOTION_COMMENT_SEEDING_TOKEN=
NOTION_COMMENT_SEEDING_DATABASE_ID=1064bf0f819748a797c195247b2ea14e

# 4. Cấu hình TikTok Module (ĐÃ ĐÓNG BĂNG - ỔN ĐỊNH)
TIKTOK_TARGET_CHANNEL=Khải Hoàn Skincare PT, Khải Hoàn & 101 Nốt Mụn
TIKTOK_SEED_KEYWORDS=chăm sóc da phan thiết, nặn mụn phan thiết, trị mụn phan thiết, spa mụn phan thiết, nặn mụn Phan Thiết, lấy nhân mụn chuẩn y khoa Phan Thiết, nặn mụn không đau Phan Thiết
TIKTOK_STEP3_TOTAL_MIN=300
TIKTOK_STEP3_TOTAL_MAX=480
TIKTOK_STEP3_VIDEO_MIN=30
TIKTOK_STEP3_VIDEO_MAX=50
TIKTOK_SEARCH_CLICK_VIDEO_ENABLED=0

# 5. Cấu hình Facebook Module
FACEBOOK_TARGET_PAGE_EXACT=Khải Hoàn Skincare, Nhà thuốc Khải Hoàn
FACEBOOK_CANONICAL_PAGE_NAME=Nhà thuốc Khải Hoàn Skincare - Chăm sóc da chuẩn y khoa Phan Thiết
FACEBOOK_SEED_KEYWORDS=chăm sóc da phan thiết, nặn mụn phan thiết, trị mụn phan thiết, spa mụn phan thiết, nặn mụn Phan Thiết, lấy nhân mụn chuẩn y khoa Phan Thiết, nặn mụn không đau Phan Thiết
FACEBOOK_STEP3_PAGE_MIN=300
FACEBOOK_STEP3_PAGE_MAX=480
FACEBOOK_STEP3_POST_DWELL_MIN=15
FACEBOOK_STEP3_POST_DWELL_MAX=30
FACEBOOK_REELS_BOOST_ENABLED=1

# 6. Tỷ lệ tương tác tự nhiên (Micro-Interactions Matrix)
INTERACTION_LIKE_RATE=0.25
INTERACTION_BOOKMARK_RATE=0.08
INTERACTION_SHARE_RATE=0.02
INTERACTION_COMMENT_RATE=0.10
INTERACTION_LOOP_RATE=0.15

# Tương tác ưu tiên video mới nhất kênh TikTok
TIKTOK_NEWEST_VIDEO_PRIORITY_COUNT=6
TIKTOK_NEWEST_LIKE_RATE=0.90
TIKTOK_NEWEST_BOOKMARK_RATE=0.35
TIKTOK_NEWEST_SHARE_RATE=0.15
TIKTOK_NEWEST_COMMENT_RATE=0.30
TIKTOK_NEWEST_LOOP_RATE=0.35

# 7. Bộ lên lịch tự động (Auto-Scheduler)
AUTO_SCHEDULE_ENABLED=0
AUTO_SCHEDULE_HOURS=11:45, 19:30, 22:30
AUTO_SCHEDULE_MODE=adaptive
SESSION_RUNS_DEFAULT=1
SESSION_DELAY_MIN_DEFAULT=30
SESSION_DELAY_MAX_DEFAULT=60
